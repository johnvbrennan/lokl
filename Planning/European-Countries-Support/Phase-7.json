      "steps": [
        "Create switchToRegion(regionId) function in main.js",
        "Show loading overlay during switch",
        "Load new region data via dataLoader",
        "Update store state with setRegion action",
        "Call mapController.switchRegion()",
        "Update UI labels with updateUIForRegion()",
        "Load region-specific statistics",
        "Hide loading overlay when complete",
        "Handle errors gracefully with fallback"
